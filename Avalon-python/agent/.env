# ============================================================
#  LLM 模型配置
# ============================================================
default_api_key=tp-c162nersrvds03vtihgosd9ni1dutwtjkfuvpj6ux2wmfqeo
default_model=mimo-v2.5
default_model_base_url=https://token-plan-cn.xiaomimimo.com/v1

# ============================================================
#  路径配置（绝对路径）
# ============================================================
prompt_file_path=f:\Avalon\data\memory\prompt

memory_path=f:\Avalon\data\memory
session_index_path=f:\Avalon\data\memory\session\index.json
session_path=f:\Avalon\data\memory\session

# ============================================================
#  向量数据库配置
# ============================================================
vector_db_path=f:\Avalon\data\vector\vector_db
model_cache_dir=f:\Avalon\data\vector\models\embedding

# ============================================================
#  Embedding 模型配置
# ============================================================
# embedding_mode: 'local' 使用本地模型，'api' 使用 API 模型
embedding_mode=local

# 本地 embedding 模型配置
local_embedding_model=bge-small-zh-v1.5
embedding_device=cuda

# API embedding 模型配置（暂未启用）
api_embedding_key=sk-xxxx
api_embedding_model=text-embedding-3-small
api_embedding_base_url=

# ============================================================
#  会话记忆配置
# ============================================================
session_memory_search_mode=hybrid

# --- 自动压缩 ---
# 输入 token 超过此阈值时自动触发会话压缩。
# 支持格式: "512k" / "20k" / "20000"
# 建议设为模型上下文窗口的 60%~70%（mimo-v2.5 推荐 20000~30000）
session_memory_compress_threshold=10000

# --- 永恒会话：渐进式总结 ---
# 压缩块超过此数量时，将最旧的多个块合并为超级摘要，防止 compressed 数组无限膨胀
session_memory_max_chunks=10

# --- 上下文窗口管理 ---
# 系统提示中只加载最近 N 个压缩块，旧块通过 search_session_memory 工具按需检索
session_memory_context_chunks=5

# ============================================================
#  飞书渠道配置
# ============================================================
LARK_APP_ID=cli_a9408d84883a1ccc
LARK_APP_SECRET=8TYaDTslIE4PlKc9qwCR5fmNT8ieU1N0
FEISHU_ENABLED=True

FEISHU_PROCESSING_REACTION=OneSecond
