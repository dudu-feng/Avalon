{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avalon",
  "version": "0.4.4",
  "identifier": "com.duedudu.avalon-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Avalon",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../data/vector/models/embedding/bge-small-zh-v1.5/config.json": "data/vector/models/embedding/bge-small-zh-v1.5/config.json",
      "../../data/vector/models/embedding/bge-small-zh-v1.5/tokenizer.json": "data/vector/models/embedding/bge-small-zh-v1.5/tokenizer.json",
      "../../data/vector/models/embedding/bge-small-zh-v1.5/model.safetensors": "data/vector/models/embedding/bge-small-zh-v1.5/model.safetensors"
    }
  }
}
